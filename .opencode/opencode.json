{
  "model": "openai/gpt-5.6-sol",
  "small_model": "ollama/minimax-m3",
  "instructions": [
    ".opencode/OPS_AGENT.md"
  ],
  "enabled_providers": [
    "openai",
    "grok",
    "ollama",
    "backup"
  ],
  "provider": {
    "openai": {
      "options": {
        "baseURL": "https://token.72602.space/v1",
        "apiKey": "{env:OPENAI_API_KEY}",
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "gpt-5.6": {
          "name": "GPT-5.6",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6-Terra",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6-Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6-Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        }
      }
    },
    "grok": {
      "options": {
        "baseURL": "https://token.72602.space/v1",
        "apiKey": "{env:GROK_API_KEY}",
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "npm": "@ai-sdk/openai",
      "name": "Grok via Sub2API",
      "models": {
        "grok-4.5": {
          "name": "Grok 4.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "grok-4.3": {
          "name": "Grok 4.3",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "grok-build-0.1": {
          "name": "Grok Build 0.1",
          "limit": {
            "context": 256000,
            "output": 128000
          }
        },
        "grok-composer-2.5-fast": {
          "name": "Grok Composer 2.5 Fast",
          "limit": {
            "context": 500000,
            "output": 128000
          }
        }
      }
    },
    "ollama": {
      "options": {
        "baseURL": "https://token.72602.space/v1",
        "apiKey": "{env:OLLAMA_API_KEY}",
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "npm": "@ai-sdk/openai",
      "name": "Ollama via Sub2API",
      "models": {
        "gemma4:31b": {
          "name": "Gemma 4 31B",
          "family": "gemma4",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "minimax-m3": {
          "name": "MiniMax M3",
          "family": "minimax-m3",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 524288,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-oss:120b": {
          "name": "GPT-OSS 120B",
          "family": "gpt-oss",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "backup": {
      "options": {
        "baseURL": "{env:BACKUP_ENDPOINT}",
        "apiKey": "{env:BACKUP_API_KEY}",
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "name": "Backup LLM",
      "models": {
        "gpt-5.6-terra": {
          "name": "GPT-5.6-Terra",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6-Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "store": false
          },
          "variants": {
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {}
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium",
      "options": {
        "store": false
      }
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "options": {
        "store": false
      },
      "permission": {
        "edit": "deny"
      }
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    },
    "explore": {
      "model": "ollama/minimax-m3"
    },
    "title": {
      "model": "ollama/minimax-m3"
    },
    "compaction": {
      "model": "ollama/minimax-m3"
    }
  },
  "mcp": {
    "sub2api-admin": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/sub2api-admin/server.mjs"
      ],
      "cwd": "/workspace",
      "environment": {
        "SUB2API_BASE_URL": "http://sub2api.application.svc.cluster.local:8080",
        "SUB2API_ALLOWED_HOST": "sub2api.application.svc.cluster.local",
        "SUB2API_TIMEOUT_MS": "30000",
        "SUB2API_MAX_RECHARGE": "10000"
      },
      "enabled": true,
      "timeout": 40000
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "sub2api-admin_*": "deny",
    "bash": {
      "*": "allow",
      "kubectl delete *": "ask",
      "kubectl * delete *": "ask",
      "kubectl drain *": "ask",
      "kubectl * drain *": "ask",
      "kubectl cordon *": "ask",
      "kubectl * cordon *": "ask",
      "kubectl taint *": "ask",
      "kubectl * taint *": "ask",
      "ssh * kubectl * delete *": "ask",
      "ssh * kubectl * drain *": "ask",
      "ssh * kubectl * cordon *": "ask",
      "ssh * kubectl * taint *": "ask",
      "sudo *": "ask",
      "* sudo *": "ask",
      "systemctl *": "ask",
      "* systemctl *": "ask",
      "rm -rf *": "ask",
      "git reset --hard*": "ask",
      "git push *--force*": "ask"
    }
  },
  "plugin": [
    "opencode-vibeguard@0.1.0",
    "@tarquinen/opencode-dcp@3.1.14",
    "@prevalentware/opencode-goal-plugin@0.1.24"
  ],
  "share": "disabled",
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 4
  },
  "experimental": {
    "openTelemetry": true
  },
  "$schema": "https://opencode.ai/config.json"
}
