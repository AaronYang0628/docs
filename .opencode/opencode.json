  "agent": {
    "build": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max",
      "options": {
        "store": false
      }
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "options": {
        "store": false
      },
      "permission": {
        "edit": "deny"
      }
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    },
    "title": {
      "model": "openai/gpt-5.6-luna"
    },
    "compaction": {
      "model": "ollama/gpt-oss:120b"
    }
  },
  "command": {
    "pass": {
      "description": "Grant a one-hour temporary IPv4 ECS access lease with /pass <ip>.",
      "agent": "build",
      "template": "Handle `/pass <ip>` as a live temporary ECS security-group lease. Accept exactly one literal IPv4 address from $ARGUMENTS; reject empty, multiple values, CIDR, hostname, and IPv6. Never infer the address from Web headers, conversation history, or the tool host. Load temporary-access-72602-operations and aliyun-72602-operations, then run the mutation through the approved 72602-minipc-local SSH alias from the 72602 execution boundary: ssh 72602-minipc-local /home/aaron/bin/temporary-ecs-access.sh grant <validated-ip>. The lease is exactly 3600 seconds and must open only TCP 22, 10021, 10022 and UDP 51820, preserving unrelated rules. Repeating an active lease must not extend it. Do not open TCP 10023, 10024, 3128, or 56396. Do not mutate UFW, WireGuard, SSH, HAProxy, DNS, or Kubernetes. Report only source, ports, lease ID, expiry, verification, and sanitized errors. Never print credentials, keys, or unrelated rules."
    }
  },
  "mcp": {
    "sub2api-admin": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/sub2api-admin/server.mjs"
      ],
      "cwd": "/workspace",
      "environment": {
        "SUB2API_BASE_URL": "http://sub2api.application.svc.cluster.local:8080",
        "SUB2API_ALLOWED_HOST": "sub2api.application.svc.cluster.local",
        "SUB2API_TIMEOUT_MS": "30000",
        "SUB2API_MAX_RECHARGE": "10000"
      },
      "enabled": true,
      "timeout": 40000
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
    "sub2api-admin_*": "deny",
    "bash": {
      "*": "allow",
      "kubectl delete *": "allow",
      "kubectl * delete *": "allow",
      "kubectl drain *": "allow",
      "kubectl * drain *": "allow",
      "kubectl cordon *": "allow",
      "kubectl * cordon *": "allow",
      "kubectl taint *": "allow",
      "kubectl * taint *": "allow",
      "ssh * kubectl * delete *": "allow",
      "ssh * kubectl * drain *": "allow",
      "ssh * kubectl * cordon *": "allow",
      "ssh * kubectl * taint *": "allow",
      "sudo *": "allow",
      "* sudo *": "allow",
      "systemctl *": "allow",
      "* systemctl *": "allow",
      "git reset --hard*": "allow",
      "git push *--force*": "allow"
    }
  },
  "plugin": [
    "opencode-vibeguard@0.1.0",
    "@prevalentware/opencode-goal-plugin@0.1.24"
  ],
  "share": "disabled",
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 4
  },
  "experimental": {
    "openTelemetry": true
  },
  "$schema": "https://opencode.ai/config.json"
}
